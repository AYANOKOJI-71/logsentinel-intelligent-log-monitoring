# Local deterministic API and web workspace ports.
LOGWATCH_API_PORT=4300
LOGWATCH_WEB_PORT=5177

# Set to opensearch only for the Compose observability lab.
LOGWATCH_STORAGE_MODE=memory
LOGWATCH_OPENSEARCH_URL=http://opensearch:9200
LOGWATCH_KAFKA_BOOTSTRAP=localhost:9092
LOGWATCH_LOG_TOPIC=application.logs.v1
LOGWATCH_ANOMALY_TOPIC=application.anomalies.v1
